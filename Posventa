        async function enviarImpresionTicketESC_POS(t) {
            if (!bluetoothCharacteristic) { 
                alert('Primero conecta tu impresora térmica en el menú "Más" > "Impresora Bluetooth"'); 
                abrirConfigurarImpresora(); 
                return; 
            }
            try {
                let encoder = new TextEncoder();
                let cmds = [
                    new Uint8Array([0x1B, 0x40]), // ESC @ (Reset)
                    new Uint8Array([0x1B, 0x61, 0x01]) // ESC a 1 (Centrado)
                ];

                cmds.push(encoder.encode(`\n${configTicket.negocio}\n`));
                cmds.push(encoder.encode(`Sabinas Coahuila\n`));
                cmds.push(encoder.encode(`--------------------------------\n`));
                cmds.push(encoder.encode(`Cliente: ${t.clienteNombre || 'General'}\n`));
                cmds.push(encoder.encode(`Direccion: ${t.clienteDir || 'Mostrador'}\n`));
                cmds.push(encoder.encode(`${t.fecha}\n`));
                cmds.push(encoder.encode(`--------------------------------\n`));

                cmds.push(new Uint8Array([0x1B, 0x61, 0x00])); // Izquierda

                if(t.items) {
                    t.items.forEach(i => {
                        let lineaCant = `${i.cant}x ${i.nombre}`;
                        let precioSub = `$${(i.precioPersonalizado * i.cant).toFixed(2)}`;
                        cmds.push(encoder.encode(`${lineaCant}\n  -> ${i.cant} x $${i.precioPersonalizado.toFixed(2)} = ${precioSub}\n`));
                    });
                } else {
                    cmds.push(encoder.encode(`${t.categoria}: ${t.descripcion}\n`));
                }

                cmds.push(new Uint8Array([0x1B, 0x61, 0x01])); // Centrado
                cmds.push(encoder.encode(`--------------------------------\n`));
                cmds.push(encoder.encode(`TOTAL: $${t.monto.toFixed(2)}\n\n`));
                cmds.push(encoder.encode(`${configTicket.pie}\n\n\n`));

                for (let cmd of cmds) {
                    await bluetoothCharacteristic.writeValue(cmd);
                }
            } catch (e) { 
                console.error(e);
                alert('Error al enviar los datos a la impresora térmica. Vuelve a vincularla.'); 
            }
        }

