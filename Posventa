            document.getElementById('prod-modal-titulo').innerText = 'Editar producto';
            document.getElementById('btn-eliminar-producto-modal').classList.remove('hidden');
            document.getElementById('modal-producto').classList.remove('hidden');
        }

        function guardarProductoInventario() {
            let id = document.getElementById('form-prod-id').value;
            let nombre = document.getElementById('form-prod-nombre').value;
            let precio = parseFloat(document.getElementById('form-prod-precio').value);
            let costo = parseFloat(document.getElementById('form-prod-costo').value) || 0;
            let stock = parseInt(document.getElementById('form-prod-stock').value) || 0;
            if(!nombre || isNaN(precio)) return alert('Llena nombre y precio');

            if(id) {
                let p = productos.find(x => x.id == id);
                p.nombre = nombre;
                p.precio = precio;
                p.costo = costo;
                p.stock = stock;
            } else {
                productos.push({ id: Date.now(), nombre, precio, costo, stock });
            }
            guardarTodo();
            cerrarModal('modal-producto');
            renderInventario();
        }

        function eliminarProductoDesdeModal() {
            let id = document.getElementById('form-prod-id').value;
            if(!confirm('¿Eliminar producto?')) return;
            productos = productos.filter(x => x.id != id);
            guardarTodo();
            cerrarModal('modal-producto');
            renderInventario();
        }

        function exportarDatos() {
            let data = JSON.stringify({ productos, clientes, transacciones, configTicket });
            let blob = new Blob([data], { type: 'json' });
            let url = URL.createObjectURL(blob);
            let a = document.createElement('a'); a.href = url; a.download = 'respaldo_yimi.json'; a.click();
        }
        function importarDatosPrompt() {
            let json = prompt('Pega el código:');
            if(!json) return;
            try {
                let data = JSON.parse(json);
                productos = data.productos || productos;
                clientes = data.clientes || clientes;
                transacciones = data.transacciones || transacciones;
                guardarTodo();
                alert('Restaurado');
                renderVenta();
            } catch(e) { alert('Inválido'); }
        }
        function borrarTodo() { if(confirm('¿Borrar todo?')) { localStorage.clear(); location.reload(); } }

        actualizarContadorClientesUI();
        renderVenta();
        renderClientesInicioScroll();
    </script>


</body></html>
