<body class="bg-gray-50 text-gray-800 font-sans pb-24">

    <!-- BOTÓN RÁPIDO PARA COPIAR CÓDIGO -->
    <div class="bg-gray-900 text-white text-xs py-1.5 px-4 text-center flex justify-between items-center">
        <span>Sistema POS Yimi - Clientes Comerciales</span>
        <button onclick="copiarCodigoFuente(this)" class="bg-blue-600 hover:bg-blue-500 text-white px-2.5 py-1 rounded text-[11px] font-bold">Copiar Código</button>
    </div>

    <!-- HEADER / SUPERIOR -->
    <header class="bg-white border-b sticky top-0 z-20 px-4 py-3 flex justify-between items-center shadow-sm">
        <div class="flex items-center gap-2">
            <span class="text-blue-600 font-black text-xl tracking-tight">YIMI</span>
            <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full font-medium" id="txt-modo">Venta</span>
        </div>
        <button onclick="abrirModalSeleccionarCliente()" id="btn-cliente-header" class="text-xs font-bold text-gray-700 flex items-center gap-1.5 bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">
            🏪 <span id="txt-cliente-actual">Cliente General</span>
        </button>
    </header>

    <!-- CONTENEDOR DE PANTALLAS (VISTAS) -->
    <main class="max-w-md mx-auto p-4">

        <!-- 1. VISTA VENTA / INICIO -->
        <div id="vista-venta" class="space-y-3">
            <!-- PANEL RÁPIDO DE CLIENTES EN INICIO -->
            <div class="bg-white p-3.5 rounded-2xl border border-gray-200 shadow-sm space-y-2">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-gray-500 flex items-center gap-1">🏪 Mis Clientes / Tiendas</span>
                    <button onclick="abrirModalClientes()" class="text-xs text-blue-600 font-bold hover:underline">Ver todos &gt;</button>
                </div>
                <div class="flex gap-2 overflow-x-auto pb-1" id="scroll-clientes-inicio">
                    <div onclick="seleccionarClienteVentaDesdeInicio(1)" class="min-w-[110px] p-2.5 rounded-xl border bg-blue-600 text-white border-blue-600 shadow-sm cursor-pointer text-left flex flex-col justify-between shrink-0 transition">
                        <span class="font-bold text-xs truncate">Cliente General</span>
                        <span class="text-[9px] opacity-80 truncate">Sin dirección</span>
                    </div>
                
                    <div onclick="seleccionarClienteVentaDesdeInicio(1790346136411)" class="min-w-[110px] p-2.5 rounded-xl border bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100 cursor-pointer text-left flex flex-col justify-between shrink-0 transition">
                        <span class="font-bold text-xs truncate">Pancjo</span>
                        <span class="text-[9px] opacity-80 truncate">Juanaaria </span>
                    </div>
                
                    <div onclick="seleccionarClienteVentaDesdeInicio(1790347311720)" class="min-w-[110px] p-2.5 rounded-xl border bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100 cursor-pointer text-left flex flex-col justify-between shrink-0 transition">
                        <span class="font-bold text-xs truncate">Jana</span>
                        <span class="text-[9px] opacity-80 truncate">Jsjeje</span>
                    </div>
                
                    <div onclick="seleccionarClienteVentaDesdeInicio(1790347317272)" class="min-w-[110px] p-2.5 rounded-xl border bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100 cursor-pointer text-left flex flex-col justify-between shrink-0 transition">
                        <span class="font-bold text-xs truncate">Jsjdjdjd</span>
                        <span class="text-[9px] opacity-80 truncate">Jajajajs</span>
                    </div>
                
                    <div onclick="seleccionarClienteVentaDesdeInicio(1790347324853)" class="min-w-[110px] p-2.5 rounded-xl border bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100 cursor-pointer text-left flex flex-col justify-between shrink-0 transition">
                        <span class="font-bold text-xs truncate">Jajajsndkdod</span>
                        <span class="text-[9px] opacity-80 truncate">Jsjdjdodms</span>
                    </div>
                </div>
            </div>

            <div class="flex gap-2 items-center">
                <div class="relative flex-1">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">🔍</span>
