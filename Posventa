        /* FACTURA DE COMPRA */
        function abrirModalCompra() {
            facturaCompraItems = [];
            document.getElementById('compra-fecha-input').value = new Date().toISOString().split('T')[0];
            poblarSelectProductosCompra();
            renderFacturaCompra();
            document.getElementById('modal-compra').classList.remove('hidden');
        }

        function poblarSelectProductosCompra() {
            const select = document.getElementById('select-prod-compra');
            select.innerHTML = '';
            productos.forEach(p => {
                select.innerHTML += `<option value="${p.id}">${p.nombre} (Actual: $${p.costo || 0})</option>`;
            });
        }

        function agregarItemAFacturaCompra() {
            const prodId = parseInt(document.getElementById('select-prod-compra').value);
            const p = productos.find(x => x.id === prodId);
            if(!p) return;

            let existente = facturaCompraItems.find(x => x.id === p.id);
            if(existente) {
                existente.cant++;
            } else {
                facturaCompraItems.push({
                    id: p.id,
                    nombre: p.nombre,
                    cant: 1,
                    costoUnitario: p.costo || 0,
                    esNuevo: false
                });
            }
            renderFacturaCompra();
        }

        function crearProductoNuevoDesdeCompra() {
            let nombre = prompt('Nombre del nuevo producto:');
            if(!nombre) return;
            let precioVenta = parseFloat(prompt('Precio de venta al cliente:', '0'));
            let costoCompra = parseFloat(prompt('Costo unitario de compra:', '0'));
            let cantidad = parseInt(prompt('Cantidad comprada:', '1'));

            if(isNaN(precioVenta) || isNaN(costoCompra) || isNaN(cantidad)) return alert('Valores inválidos');

            let nuevoProd = {
                id: Date.now(),
                nombre: nombre,
                precio: precioVenta,
                costo: costoCompra,
                stock: 0
            };
            productos.push(nuevoProd);

            facturaCompraItems.push({
                id: nuevoProd.id,
                nombre: nuevoProd.nombre,
                cant: cantidad,
                costoUnitario: costoCompra,
                esNuevo: true
            });
            poblarSelectProductosCompra();
            renderFacturaCompra();
        }

        function renderFacturaCompra() {
            const contenedor = document.getElementById('lista-items-factura-compra');
            contenedor.innerHTML = '';
            if(facturaCompraItems.length === 0) {
                contenedor.innerHTML = '<p class="text-xs text-gray-400 text-center py-4">No hay ítems en esta factura</p>';
                document.getElementById('total-factura-compra').innerText = '$0.00';
                return;
            }

            let totalCompra = 0;
            facturaCompraItems.forEach((item, idx) => {
                let sub = item.cant * item.costoUnitario;
                totalCompra += sub;
                contenedor.innerHTML += `
                    <div class="bg-gray-50 p-2.5 rounded-xl border flex justify-between items-center text-xs">
                        <div>
                            <span class="font-bold block text-gray-800">${item.nombre}</span>
                            <span class="text-gray-500">Cant: <input type="number" value="${item.cant}" onchange="cambiarCantFactura(${idx}, this.value)" class="w-12 p-1 border rounded text-center font-bold"> | Costo: $<input type="number" step="0.01" value="${item.costoUnitario}" onchange="cambiarCostoFactura(${idx}, this.value)" class="w-16 p-1 border rounded text-center font-bold"></span>
                        </div>
                        <span class="font-bold text-purple-700">$${sub.toFixed(2)}</span>
                    </div>
                `;
            });
            document.getElementById('total-factura-compra').innerText = `$${totalCompra.toFixed(2)}`;
        }

        function cambiarCantFactura(idx, val) {
            facturaCompraItems[idx].cant = parseInt(val) || 1;
            renderFacturaCompra();
        }

        function cambiarCostoFactura(idx, val) {
            facturaCompraItems[idx].costoUnitario = parseFloat(val) || 0;
            renderFacturaCompra();
        }

        function guardarFacturaCompraFinal() {
            if(facturaCompraItems.length === 0) return alert('La factura está vacía');
            let totalCompra = facturaCompraItems.reduce((a, b) => a + (b.cant * b.costoUnitario), 0);
            let fechaInput = document.getElementById('compra-fecha-input').value || new Date().toISOString().split('T')[0];

            facturaCompraItems.forEach(item => {
                let prod = productos.find(x => x.id === item.id);
                if(prod) {
                    let stockAnterior = prod.stock || 0;
                    let costoAnterior = prod.costo || 0;
                    let stockNuevo = item.cant;
                    let costoNuevo = item.costoUnitario;

                    let stockTotalFuturo = stockAnterior + stockNuevo;
                    if(stockTotalFuturo > 0) {
                        let inversionAnterior = stockAnterior * costoAnterior;
                        let inversionNueva = stockNuevo * costoNuevo;
                        prod.costo = (inversionAnterior + inversionNueva) / stockTotalFuturo;
                    } else {
                        prod.costo = costoNuevo;
                    }
                    prod.stock += stockNuevo;
