        /* IMPRESIÓN BLUETOOTH ESC/POS */
        async function abrirConfigurarImpresora() {
            try {
                if (!navigator.bluetooth) { 
                    alert('Tu navegador no soporta Web Bluetooth. Usa Chrome en Android o PC.'); 
                    return; 
                }
                
                bluetoothDevice = await navigator.bluetooth.requestDevice({ 
                    acceptAllDevices: true, 
                    optionalServices: ['000018f0-0000-1000-8000-00805f9b34fb', '0000ff00-0000-1000-8000-00805f9b34fb', '49535343-fe7d-4ae5-8fa9-9fafd205e455'] 
                });
                
                const server = await bluetoothDevice.gatt.connect();
                const services = await server.getPrimaryServices();
                
                for (let service of services) {
                    const characteristics = await service.getCharacteristics();
                    for (let characteristic of characteristics) {
                        if (characteristic.properties.write || characteristic.properties.writeWithoutResponse) {
                            bluetoothCharacteristic = characteristic;
                            break;
                        }
                    }
                    if (bluetoothCharacteristic) break;
                }

                if (!bluetoothCharacteristic) {
                    alert('Dispositivo conectado, pero no se encontró una característica de escritura válida.');
                    return;
                }

                document.getElementById('estado-impresora-txt').innerText = `${bluetoothDevice.name || 'Conectada'} ✓`;
                alert('¡Impresora térmica vinculada con éxito!');
            } catch (error) { 
                console.error(error);
                alert('No se pudo conectar con la impresora o se canceló la selección.'); 
            }
        }

        async function imprimirTicketBluetooth() {
            let ultimo = transacciones.find(x => x.tipo === 'Venta');
            if(ultimo) await enviarImpresionTicketESC_POS(ultimo);
            else alert('No hay ventas recientes para imprimir.');
