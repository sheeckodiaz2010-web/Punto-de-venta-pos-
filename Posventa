        function abrirModalFormCliente() {
            document.getElementById('form-cliente-id').value = '';
            document.getElementById('form-cliente-nombre').value = '';
            document.getElementById('form-cliente-dir').value = '';
            document.getElementById('form-cliente-tel').value = '';
            document.getElementById('titulo-form-cliente').innerText = 'Nueva Tienda / Cliente';
            document.getElementById('btn-eliminar-cliente').classList.add('hidden');
            document.getElementById('modal-form-cliente').classList.remove('hidden');
        }

        function editarCliente(id) {
            let c = clientes.find(x => x.id === id);
            if(!c) return;
            document.getElementById('form-cliente-id').value = c.id;
            document.getElementById('form-cliente-nombre').value = c.nombre;
            document.getElementById('form-cliente-dir').value = c.direccion || '';
            document.getElementById('form-cliente-tel').value = c.telefono || '';
            document.getElementById('titulo-form-cliente').innerText = 'Editar Tienda / Cliente';
            document.getElementById('btn-eliminar-cliente').classList.remove('hidden');
            document.getElementById('modal-form-cliente').classList.remove('hidden');
        }

        function guardarClienteForm() {
            let id = document.getElementById('form-cliente-id').value;
            let nombre = document.getElementById('form-cliente-nombre').value;
            let dir = document.getElementById('form-cliente-dir').value;
            let tel = document.getElementById('form-cliente-tel').value;
            if(!nombre) return alert('Escribe el nombre de la tienda o cliente');

            if(id) {
                let c = clientes.find(x => x.id == id);
                if(c) { c.nombre = nombre; c.direccion = dir; c.telefono = tel; }
            } else {
                clientes.push({ id: Date.now(), nombre, direccion: dir, telefono: tel });
            }
            guardarTodo();
            cerrarModal('modal-form-cliente');
            renderClientesAdmin();
            renderClientesInicioScroll();
        }

        function eliminarClienteActual() {
            let id = parseInt(document.getElementById('form-cliente-id').value);
            if(clientes.length <= 1) return alert('Debes tener al menos un cliente');
            if(!confirm('¿Eliminar esta tienda/cliente?')) return;
            clientes = clientes.filter(x => x.id !== id);
            if(clienteSeleccionado.id === id) clienteSeleccionado = clientes[0];
            guardarTodo();
            cerrarModal('modal-form-cliente');
            renderClientesAdmin();
            renderClientesInicioScroll();
        }

        function abrirModalSeleccionarCliente() {
            const contenedor = document.getElementById('lista-clientes-seleccion');
            contenedor.innerHTML = '';
            clientes.forEach(c => {
                let activo = clienteSeleccionado.id === c.id ? 'border-blue-600 bg-blue-50 text-blue-700' : 'border-gray-200 bg-gray-50';
