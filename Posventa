        let configTicket = JSON.parse(localStorage.getItem('yimi_config_ticket')) || { negocio: 'DIGAR', pie: '¡GRACIAS POR SU COMPRA!' };
        let ventaSeleccionadaId = null;
        let indexItemConfigActivo = null;
        let modoVistaGrid = true;
        let categoriaTransaccionSeleccionada = 'Compra';
        let bluetoothDevice = null;
        let bluetoothCharacteristic = null;

        function copiarCodigoFuente(btn) {
            navigator.clipboard.writeText(document.documentElement.outerHTML).then(() => {
                let original = btn.innerText;
                btn.innerText = '¡Copiado!';
                setTimeout(() => btn.innerText = original, 2000);
            });
        }

        function guardarTodo() {
            localStorage.setItem('yimi_productos', JSON.stringify(productos));
            localStorage.setItem('yimi_clientes', JSON.stringify(clientes));
            localStorage.setItem('yimi_trans', JSON.stringify(transacciones));
            localStorage.setItem('yimi_config_ticket', JSON.stringify(configTicket));
            actualizarContadorClientesUI();
        }

        function actualizarContadorClientesUI() {
            let total = clientes.length;
            let el = document.getElementById('total-clientes-badge');
            if(el) el.innerText = `${total} Clientes >`;
            let sub = document.getElementById('sub-total-clientes');
            if(sub) sub.innerText = `Total: ${total} clientes / tiendas`;
            renderClientesInicioScroll();
        }

        function renderClientesInicioScroll() {
            const container = document.getElementById('scroll-clientes-inicio');
            if(!container) return;
            container.innerHTML = '';
            clientes.forEach(c => {
                let activo = clienteSeleccionado.id === c.id ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-gray-50 text-gray-700 border-gray-200 hover:bg-gray-100';
                container.innerHTML += `
                    <div onclick="seleccionarClienteVentaDesdeInicio(${c.id})" class="min-w-[110px] p-2.5 rounded-xl border ${activo} cursor-pointer text-left flex flex-col justify-between shrink-0 transition">
                        <span class="font-bold text-xs truncate">${c.nombre}</span>
                        <span class="text-[9px] opacity-80 truncate">${c.direccion || 'Sin dirección'}</span>
                    </div>
                `;
            });
        }

        function seleccionarClienteVentaDesdeInicio(id) {
            let c = clientes.find(x => x.id === id);
            if(c) {
                clienteSeleccionado = c;
                document.getElementById('txt-cliente-actual').innerText = c.nombre;
                let btnPago = document.getElementById('pago-cliente-btn');
                if(btnPago) btnPago.innerText = c.nombre;
                renderClientesInicioScroll();
            }
        }

        function cambiarVista(v) {
            ['venta', 'productos', 'transacciones', 'mas'].forEach(vista => {
                const el = document.getElementById(`vista-${vista}`);
                const nav = document.getElementById(`nav-${vista}`);
                if(el) el.classList.add('hidden');
                if(nav) {
                    nav.classList.remove('text-blue-600', 'font-bold');
                    nav.classList.add('text-gray-400', 'font-medium');
                }
            });

            if(v === 'inicio') v = 'venta';
            const vistaActiva = document.getElementById(`vista-${v}`);
            const navActivo = document.getElementById(`nav-${v}`);
            if(vistaActiva) vistaActiva.classList.remove('hidden');
            if(navActivo) {
                navActivo.classList.add('text-blue-600', 'font-bold');
                navActivo.classList.remove('text-gray-400', 'font-medium');
            }

            document.getElementById('txt-modo').innerText = v === 'mas' ? 'Ajustes' : (v === 'venta' ? 'Inicio / Venta' : (v.charAt(0).toUpperCase() + v.slice(1)));

            if(v === 'venta') { renderVenta(); renderClientesInicioScroll(); }
            if(v === 'productos') renderInventario();
            if(v === 'transacciones') {
                inicializarFiltrosFechas();
                renderTransacciones();
            }
            if(v === 'mas') actualizarContadorClientesUI();
        }

        /* GESTIÓN DE CLIENTES / TIENDAS */
        function abrirModalClientes() {
            renderClientesAdmin();
            document.getElementById('modal-clientes').classList.remove('hidden');
        }

        function renderClientesAdmin() {
            const contenedor = document.getElementById('lista-clientes-admin');
            contenedor.innerHTML = '';
            actualizarContadorClientesUI();
            clientes.forEach(c => {
                contenedor.innerHTML += `
                    <div class="bg-gray-50 p-3 rounded-xl border flex justify-between items-center text-sm">
